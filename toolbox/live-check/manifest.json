{
  "manifest_version": 3,
  "name": "Appilot-Check",
  "version": "0.2.0",
  "description": "Prüft die geöffnete Seite wie ein Screenreader und testet, ob Appilot Fragen dazu beantworten und führen kann.",
  "permissions": [
    "debugger",
    "storage",
    "tabs",
    "activeTab"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Appilot-Check",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "options_page": "options.html"
}