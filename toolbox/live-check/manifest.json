{
  "manifest_version": 3,
  "name": "Appilot-Check",
  "version": "0.1.0",
  "description": "Prüft die geöffnete Seite wie ein Screenreader: Kann Appilot diese Anwendung zuverlässig verstehen?",
  "permissions": [
    "debugger",
    "storage",
    "tabs",
    "activeTab"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Appilot-Check",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}